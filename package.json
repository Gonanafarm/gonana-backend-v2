{
  "name": "gonana-api",
  "version": "1.0.0",
  "description": "",
  "author": "Joshua Nwafor",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist logs",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write src test --ignore-unknown",
    "start": "node dist/main.js",
    "start:ts": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start:debug": "tsc-watch -p tsconfig.build.json --onSuccess \"node --inspect-brk dist/main.js\"",
    "start:prod": "node dist/main.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --detectOpenHandles --config  ./test/jest-e2e.json"
  },
  "dependencies": {
    "@concordium/node-sdk": "9.4.0",
    "@grpc/grpc-js": "^1.11.1",
    "@nest-middlewares/serve-static": "6.0.0",
    "@nest-modules/mailer": "1.3.22",
    "@nestjs/axios": "^3.0.0",
    "@nestjs/common": "8.2.6",
    "@nestjs/core": "8.2.6",
    "@nestjs/event-emitter": "^1.4.1",
    "@nestjs/jwt": "8.0.0",
    "@nestjs/mongoose": "9.0.2",
    "@nestjs/passport": "8.1.0",
    "@nestjs/platform-express": "8.2.6",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/swagger": "5.1.5",
    "@types/cache-manager": "^4.0.1",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node-geocoder": "^4.2.1",
    "axios": "^1.5.0",
    "bcryptjs": "2.4.3",
    "buffer-to-stream": "^1.0.0",
    "bunyan": "1.8.15",
    "cache-manager": "^4.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.13.2",
    "cloudinary": "^1.37.3",
    "compression": "1.7.4",
    "dotenv": "14.2.0",
    "ethers": "5.4",
    "firebase-admin": "^11.0.1",
    "helmet": "5.0.2",
    "libsodium-wrappers": "^0.7.14",
    "lodash": "4.17.21",
    "moment": "^2.30.1",
    "mongoose": "6.1.7",
    "morgan": "1.10.0",
    "nest": "^0.1.6",
    "nest-morgan": "2.0.0",
    "nestjs": "^0.0.1",
    "node-geocoder": "^4.2.0",
    "nodemailer": "6.7.2",
    "param-case": "^3.0.4",
    "passport": "0.5.2",
    "passport-jwt": "4.0.0",
    "passport-local": "1.0.0",
    "reflect-metadata": "^0.1.13",
    "rotating-file-stream": "^1.4.3",
    "rxjs": "^7",
    "superagent": "^8.0.0",
    "supertest": "^6.2.4",
    "swagger-ui-express": "^4.0.7",
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@nestjs/testing": "8.2.6",
    "@types/bcryptjs": "2.4.2",
    "@types/buffer-to-stream": "^1.0.0",
    "@types/bunyan": "1.8.8",
    "@types/compression": "1.7.2",
    "@types/dotenv": "8.2.0",
    "@types/express": "4.17.0",
    "@types/helmet": "4.0.0",
    "@types/jest": "24.0.15",
    "@types/lodash": "4.14.178",
    "@types/mongoose": "5.11.97",
    "@types/morgan": "1.9.3",
    "@types/multer": "^1.4.7",
    "@types/node": "14.18.2",
    "@types/nodemailer": "6.4.4",
    "@types/passport-jwt": "3.0.6",
    "@types/passport-local": "1.0.34",
    "@types/uuid": "8.3.4",
    "@types/validator": "13.7.1",
    "@typescript-eslint/eslint-plugin": "5.10.0",
    "@typescript-eslint/parser": "5.10.0",
    "eslint": "8.7.0",
    "jest": "24.8.0",
    "mongoose-seed-2": "^0.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "2.5.1",
    "rimraf": "3.0.2",
    "ts-jest": "24.0.2",
    "ts-node": "10.4.0",
    "tsc-watch": "4.6.0",
    "tsconfig-paths": "3.12.0",
    "typescript": "4.5.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
